{
  "name": "clinder",
  "version": "0.9.7",
  "description": "Clinder is a lightweight, always-running clipboard history manager designed for fast, keyboard-only use.",
  "license": "MIT",
  "author": "oktntko@gmail.com",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:windows:build": "tauri-windows-bundle build",
    "spell-check": "cspell .",
    "lint": "oxlint --type-aware --type-check",
    "format": "oxfmt",
    "tag": "tsx script/tag.ts",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs:preview": "pnpm --filter docs preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-global-shortcut": "~2.3.2",
    "@tauri-apps/plugin-log": "~2.9.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "~2.4.4",
    "clsx": "^2.1.1",
    "medium-zoom": "^1.1.0",
    "path-browserify-esm": "^1.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@choochmeque/tauri-windows-bundle": "^0.1.29",
    "@cspell/eslint-plugin": "^10.2.2",
    "@iconify/json": "^2.2.525",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@tsconfig/node26": "^26.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cspell": "^10.2.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  },
  "packageManager": "pnpm@11.25.0"
}
